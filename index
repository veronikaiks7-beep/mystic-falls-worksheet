<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Mystic Falls Upper East Side Chronicles</title>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #0d0d12;
            --container-bg: rgba(20, 15, 25, 0.85);
            --gold: #c9a84c;
            --gold-hover: #e0c068;
            --emerald: #2e4d3a;
            --purple: #4a2e5c;
            --text-main: #e0e0e0;
            --text-muted: #a0a0a0;
            --correct: #4caf50;
            --incorrect: #f44336;
        }

        body {
            background: radial-gradient(circle at center, #1a0b2e, #0d0d12);
            color: var(--text-main);
            font-family: 'Montserrat', sans-serif;
            margin: 0;
            padding: 20px;
            line-height: 1.6;
            min-height: 100vh;
        }

        .container {
            max-width: 850px;
            margin: 0 auto;
            background: var(--container-bg);
            border: 1px solid var(--gold);
            box-shadow: 0 0 30px rgba(201, 168, 76, 0.15);
            padding: 40px;
            border-radius: 4px;
            position: relative;
            overflow: hidden;
        }

        /* Декоративные элементы */
        .container::before {
            content: '🦇';
            position: absolute;
            top: 10px;
            right: 20px;
            font-size: 2em;
            opacity: 0.2;
        }
        .container::after {
            content: '🗝️';
            position: absolute;
            bottom: 10px;
            left: 20px;
            font-size: 2em;
            opacity: 0.2;
        }

        h1, h2, h3 {
            font-family: 'Cinzel', serif;
            color: var(--gold);
            text-align: center;
            letter-spacing: 1px;
        }

        h1 {
            font-size: 2.2em;
            border-bottom: 2px solid var(--purple);
            padding-bottom: 15px;
            margin-bottom: 5px;
            text-shadow: 0 0 10px rgba(201, 168, 76, 0.4);
        }

        .subtitle {
            text-align: center;
            font-style: italic;
            color: var(--text-muted);
            margin-bottom: 30px;
            font-size: 0.9em;
        }

        .student-info {
            display: flex;
            justify-content: space-between;
            border-bottom: 1px solid var(--purple);
            padding-bottom: 10px;
            margin-bottom: 40px;
            font-size: 0.9em;
        }

        .task-block {
            margin-bottom: 45px;
            border-left: 3px solid var(--emerald);
            padding-left: 20px;
        }

        .task-title {
            font-family: 'Cinzel', serif;
            color: var(--gold);
            font-size: 1.3em;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .task-title::before {
            content: '🩸';
            font-size: 0.8em;
        }

        p, li {
            font-size: 1em;
        }

        .word-bank {
            background: rgba(74, 46, 92, 0.3);
            border: 1px dashed var(--gold);
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 4px;
            font-size: 0.9em;
            color: var(--gold);
            text-align: center;
        }

        /* Стили для полей ввода */
        input[type="text"] {
            background: transparent;
            border: none;
            border-bottom: 1px solid var(--gold);
            color: var(--gold);
            font-family: 'Montserrat', sans-serif;
            font-size: 1em;
            padding: 2px 5px;
            outline: none;
            transition: all 0.3s ease;
            text-align: center;
            min-width: 120px;
        }

        input[type="text"]:focus {
            border-bottom: 2px solid #fff;
            box-shadow: 0 5px 10px -5px rgba(201, 168, 76, 0.5);
        }

        input[type="text"].correct {
            border-bottom: 2px solid var(--correct);
            color: var(--correct);
        }

        input[type="text"].incorrect {
            border-bottom: 2px solid var(--incorrect);
            color: var(--incorrect);
        }

        /* Стили для выпадающих списков */
        select {
            background: rgba(0, 0, 0, 0.6);
            color: var(--text-main);
            border: 1px solid var(--purple);
            padding: 5px 10px;
            font-family: 'Montserrat', sans-serif;
            border-radius: 3px;
            outline: none;
            cursor: pointer;
        }
        select:focus {
            border-color: var(--gold);
        }

        /* Стили для текстовых областей */
        textarea {
            width: 100%;
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid var(--purple);
            color: var(--text-main);
            font-family: 'Montserrat', sans-serif;
            padding: 10px;
            border-radius: 4px;
            resize: vertical;
            outline: none;
            box-sizing: border-box;
        }
        textarea:focus {
            border-color: var(--gold);
        }

        .timeline-item {
            display: flex;
            align-items: center;
            margin-bottom: 12px;
            gap: 10px;
        }
        .timeline-date {
            font-family: 'Cinzel', serif;
            color: var(--gold);
            min-width: 70px;
            font-weight: bold;
        }

        /* Кнопки */
        .btn-container {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 40px;
            flex-wrap: wrap;
        }

        button {
            background: transparent;
            border: 1px solid var(--gold);
            color: var(--gold);
            padding: 12px 25px;
            font-family: 'Cinzel', serif;
            font-size: 1em;
            cursor: pointer;
            transition: all 0.3s ease;
            border-radius: 3px;
            letter-spacing: 1px;
        }

        button:hover {
            background: var(--gold);
            color: var(--bg-color);
            box-shadow: 0 0 15px rgba(201, 168, 76, 0.4);
        }

        button.reset-btn {
            border-color: var(--purple);
            color: var(--purple);
        }
        button.reset-btn:hover {
            background: var(--purple);
            color: #fff;
        }

        /* Ключи */
        .answer-key {
            display: none;
            margin-top: 40px;
            padding: 25px;
            background: rgba(46, 77, 58, 0.2);
            border: 1px solid var(--emerald);
            border-radius: 4px;
        }
        .answer-key h3 {
            margin-top: 0;
            color: var(--emerald);
        }
        .answer-key p {
            font-size: 0.9em;
            margin: 5px 0;
        }
        .answer-key strong {
            color: var(--gold);
        }

        /* Адаптивность */
        @media (max-width: 600px) {
            .container { padding: 20px; }
            h1 { font-size: 1.6em; }
            .timeline-item { flex-direction: column; align-items: flex-start; gap: 2px; }
            input[type="text"] { min-width: 80px; }
        }

        /* Печать */
        @media print {
            body { background: #fff; color: #000; padding: 0; }
            .container { background: #fff; border: none; box-shadow: none; padding: 0; max-width: 100%; }
            h1, h2, h3, .task-title, .timeline-date { color: #000; }
            .subtitle { color: #555; }
            input[type="text"], textarea, select { border-bottom: 1px solid #000; color: #000; background: transparent; }
            .word-bank { border-color: #000; color: #000; background: #f0f0f0; }
            .btn-container, .answer-key, .container::before, .container::after { display: none !important; }
            .task-block { border-left: 2px solid #000; }
        }
    </style>
</head>
<body>

<div class="container">
    <h1>The Mystic Falls<br>Upper East Side Chronicles</h1>
    <div class="subtitle">"You know you love me. XOXO" — Gossip Girl</div>

    <div class="student-info">
        <span>Student: _________________________</span>
